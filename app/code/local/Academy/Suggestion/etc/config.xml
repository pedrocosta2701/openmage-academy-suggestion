<?xml version="1.0"?>
<config>
    <modules>
        <Academy_Suggestion>
            <version>1.0.1</version>
        </Academy_Suggestion>
    </modules>
    <global>
        <models>
            <academy_suggestion>
                <class>Academy_Suggestion_Model</class>
                <resourceModel>academy_suggestion_resource</resourceModel>
            </academy_suggestion>
            <academy_suggestion_resource>
                <class>Academy_Suggestion_Model_Resource</class>
                <entities>
                    <category>
                        <table>academy_suggestion_category</table>
                    </category>
                    <suggestion>
                        <table>academy_suggestion</table>
                    </suggestion>
                </entities>
            </academy_suggestion_resource>
        </models>
        <blocks>
            <academy_suggestion>
                <class>Academy_Suggestion_Block</class>
            </academy_suggestion>
        </blocks>
        <helpers>
            <academy_suggestion>
                <class>Academy_Suggestion_Helper</class>
            </academy_suggestion>
        </helpers>
        <resources>
            <academy_suggestion_setup>
                <setup>
                    <module>Academy_Suggestion</module>
                    <class>Mage_Core_Model_Resource_Setup</class>
                </setup>
            </academy_suggestion_setup>
        </resources>
    </global>
</config>